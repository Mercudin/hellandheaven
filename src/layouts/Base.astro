---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  current: 'home' | 'writing' | 'about';
}

const { title, description, current } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500&display=swap"
    />
    <link rel="alternate" type="application/rss+xml" title="Hell and Heaven" href="/rss.xml" />
  </head>
  <body>
    <div class="wrap">
      <header>
        <a class="mark" href="/">Hell and Heaven</a>
        <nav>
          <a href="/" aria-current={current === 'home' ? 'page' : undefined}>Home</a>
          <a href="/writing" aria-current={current === 'writing' ? 'page' : undefined}>Writing</a>
          <a href="/about" aria-current={current === 'about' ? 'page' : undefined}>About</a>
        </nav>
      </header>
      <slot />
      <footer>hellandheaven.com <a href="/about">About</a></footer>
    </div>
  </body>
</html>
