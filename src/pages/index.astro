---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Base title="Hell and Heaven" description="Nothing published yet." current="home">
  <p class="kicker">Hell and Heaven</p>
  <h1>Writing.</h1>
  <p class="lede">Nothing published yet.</p>
  {posts.length === 0 ? (
    <div class="empty">When a piece is ready, it will show up here.</div>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/writing/${post.slug}/`}>
            <span class="title">{post.data.title}</span>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          </a>
          {post.data.description && <p class="desc">{post.data.description}</p>}
        </li>
      ))}
    </ul>
  )}
</Base>
